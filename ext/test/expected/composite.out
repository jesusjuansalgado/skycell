ERROR:  an empty region has no centroid
-- a constant composite on the catalogue index -------------------------
CREATE TABLE ccat AS
SELECT i AS id, ra, dec, skycell_point(ra, dec) AS pos FROM (
  SELECT i, CASE WHEN i % 2 = 0 THEN 6 + 8 * random() ELSE 360 * random() END AS ra,
            CASE WHEN i % 2 = 0 THEN 16 + 8 * random() ELSE degrees(asin(2 * random() - 1)) END AS dec
  FROM generate_series(1, 100000) i) s;
CREATE INDEX ccat_pos ON ccat (skycell_cell(pos));
ANALYZE ccat;
CREATE TABLE cregs(name text, r skyregion);
INSERT INTO cregs VALUES
  ('annulus',      region('DIFFERENCE ICRS (CIRCLE 10 20 2 CIRCLE 10 20 1)')),
  ('two circles',  region('UNION ICRS (CIRCLE 8 18 1 CIRCLE 12 22 1.5)')),
  ('lens',         region('INTERSECTION ICRS (CIRCLE 10 20 2 CIRCLE 11.5 20 2)')),
  ('box less U',   skycell_difference(box('ICRS', 10, 20, 6, 6),
                     polygon('ICRS', 8,18, 12,18, 12,22, 11,22, 11,19, 9,19, 9,22, 8,22))),
  ('three-way',    region('INTERSECTION ICRS (CIRCLE 10 20 3 NOT (CIRCLE 9 19 1) POLYGON 6 16 14 16 10 24)')),
  ('not a cap',    region('NOT ICRS (CIRCLE 10 20 60)')),
  ('nested',       region('UNION ICRS (DIFFERENCE (CIRCLE 10 20 3 CIRCLE 10 20 2) INTERSECTION (CIRCLE 10 20 1 NOT (CIRCLE 10 20 0.3)))')),
  ('empty',        region('INTERSECTION ICRS (CIRCLE 0 0 1 CIRCLE 90 0 1)'));
CREATE FUNCTION comp_plan_uses_index(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text; found bool := false;
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    IF l ~ 'Index (Only )?Scan|Bitmap Index Scan|SkycellCone' THEN found := true; END IF;
  END LOOP;
  RETURN found;
END $$;
CREATE FUNCTION comp_counts(reg skyregion, OUT idx text, OUT seq text, OUT exact text, OUT indexed bool)
LANGUAGE plpgsql AS $$
DECLARE q text := format('SELECT count(*) || '':'' || coalesce(sum(id), 0) FROM ccat WHERE pos <@ %L::skyregion', reg::text);
BEGIN
  EXECUTE format('SELECT count(*) || '':'' || coalesce(sum(id), 0) FROM ccat WHERE skycell_in_region(pos, %L::skyregion)', reg::text) INTO exact;
  SET LOCAL enable_seqscan = off;
  EXECUTE q INTO idx;
  indexed := comp_plan_uses_index(q);
  SET LOCAL enable_seqscan = on;
  SET LOCAL enable_indexscan = off;
  SET LOCAL enable_bitmapscan = off;
  EXECUTE q INTO seq;
END $$;
-- (an empty composite needs no index: the planner folds it to false)
SELECT name, c.idx = c.seq AND c.idx = c.exact AS agree, split_part(c.seq, ':', 1)::int > 0 AS nonempty, c.indexed
FROM cregs, comp_counts(r) c ORDER BY name;
    name     | agree | nonempty | indexed 
-------------+-------+----------+---------
 annulus     | t     | t        | t
 box less U  | t     | t        | t
 empty       | t     | f        | t
 lens        | t     | t        | t
 nested      | t     | t        | t
 not a cap   | t     | t        | t
 three-way   | t     | t        | t
 two circles | t     | t        | t
(8 rows)

-- the ADQL spelling too
SELECT count(*) = (SELECT count(*) FROM ccat, cregs WHERE name = 'annulus' AND skycell_in_region(pos, r)) AS adql_agrees
FROM ccat WHERE contains(pos, region('DIFFERENCE ICRS (CIRCLE 10 20 2 CIRCLE 10 20 1)')) = 1;
 adql_agrees 
-------------
 t
(1 row)

-- which plan: a top-level composite goes to the custom scan (0.39), over its
-- covering's ranges, as a cone does, from a skypos column or from ra and dec;
-- under an OR with other regions of the same position it is folded with them
-- (0.53); with the custom scan off it keeps the range rewrite.  Every plan must
-- give the rows of the exact tests, joined as written (no fold, no index).
CREATE INDEX ccat_radec ON ccat (skycell_ang2cell(ra, dec));
ANALYZE ccat;
CREATE FUNCTION comp_plan_kind(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
  SET LOCAL enable_seqscan = off;   -- the patch is dense: compare index plans only
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    IF l ~ 'SkycellCone' THEN RETURN 'custom scan'; END IF;
    IF l ~ 'Bitmap Index Scan|Index Scan|Index Only Scan' THEN RETURN 'range rewrite'; END IF;
  END LOOP;
  RETURN 'other';
END $$;
CREATE FUNCTION comp_plan_rows(q text, OUT kind text, OUT agree bool) LANGUAGE plpgsql AS $$
DECLARE n bigint; m bigint;
BEGIN
  kind := comp_plan_kind(q);
  EXECUTE q INTO n;
  SET LOCAL enable_indexscan = off;
  SET LOCAL enable_bitmapscan = off;
  SET LOCAL skycell.custom_scan = off;
  SET LOCAL skycell.fold_regions = off;
  EXECUTE q INTO m;
  agree := n = m;
  -- SET LOCAL lasts to the end of the statement's transaction, which runs
  -- every row of the query calling this: restore for the next one
  SET LOCAL enable_indexscan = on;
  SET LOCAL enable_bitmapscan = on;
  SET LOCAL skycell.custom_scan = on;
  SET LOCAL skycell.fold_regions = on;
END $$;
SELECT name, (comp_plan_rows(q)).* FROM (VALUES
  ('pos <@ union',        'SELECT count(*) FROM ccat WHERE pos <@ region(''UNION ICRS (CIRCLE 8 18 1 CIRCLE 12 22 1.5)'')'),
  ('ADQL annulus',        'SELECT count(*) FROM ccat WHERE CONTAINS(POINT(''ICRS'', ra, dec), REGION(''DIFFERENCE ICRS (CIRCLE 10 20 2 CIRCLE 10 20 1)'')) = 1'),
  ('region @> pos, NOT',  'SELECT count(*) FROM ccat WHERE region(''NOT ICRS (CIRCLE 10 20 60)'') @> pos'),
  ('with another term',   'SELECT count(*) FROM ccat WHERE id % 2 = 0 AND pos <@ region(''INTERSECTION ICRS (CIRCLE 10 20 2 CIRCLE 11.5 20 2)'')'),
  ('under an OR',         'SELECT count(*) FROM ccat WHERE pos <@ region(''UNION ICRS (CIRCLE 8 18 1 CIRCLE 12 22 1.5)'') OR pos <@ circle(''ICRS'', 200, -30, 1)')
) v(name, q) ORDER BY name;
        name        |    kind     | agree 
--------------------+-------------+-------
 ADQL annulus       | custom scan | t
 pos <@ union       | custom scan | t
 region @> pos, NOT | custom scan | t
 under an OR        | custom scan | t
 with another term  | custom scan | t
(5 rows)

SET skycell.custom_scan = off;
SELECT comp_plan_kind('SELECT count(*) FROM ccat WHERE pos <@ region(''UNION ICRS (CIRCLE 8 18 1 CIRCLE 12 22 1.5)'')') AS custom_scan_off;
 custom_scan_off 
-----------------
 range rewrite
(1 row)

RESET skycell.custom_scan;
-- booleans of constant regions on one position, folded into one composite
-- (0.53): OR to a union, AND to an intersection, AND NOT to a difference,
-- ADQL's = 1 and = 0, nested; not across two positions, nor an OR holding a
-- term on something else; and each as written with the fold off
SELECT name, (comp_plan_rows(q)).* FROM (VALUES
  ('OR of two',           'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 8, 18, 1) OR pos <@ circle(''ICRS'', 12, 22, 1.5)'),
  ('OR of three, ADQL',   'SELECT count(*) FROM ccat WHERE CONTAINS(POINT(''ICRS'', ra, dec), CIRCLE(''ICRS'', 8, 18, 1)) = 1 OR CONTAINS(POINT(''ICRS'', ra, dec), BOX(''ICRS'', 12, 22, 2, 1)) = 1 OR CONTAINS(POINT(''ICRS'', ra, dec), CIRCLE(''ICRS'', 10, 20, 0.5)) = 1'),
  ('AND of two',          'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 10, 20, 2) AND pos <@ circle(''ICRS'', 11.5, 20, 2)'),
  ('AND NOT',             'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 10, 20, 2) AND NOT pos <@ circle(''ICRS'', 10, 20, 1)'),
  ('ADQL = 0',            'SELECT count(*) FROM ccat WHERE CONTAINS(POINT(''ICRS'', ra, dec), CIRCLE(''ICRS'', 10, 20, 2)) = 1 AND CONTAINS(POINT(''ICRS'', ra, dec), CIRCLE(''ICRS'', 10, 20, 1)) = 0'),
  ('nested',              'SELECT count(*) FROM ccat WHERE (pos <@ circle(''ICRS'', 8, 18, 1.5) OR circle(''ICRS'', 12, 22, 1.5) @> pos) AND NOT pos <@ box(''ICRS'', 10, 20, 8, 0.5) AND id % 3 > 0'),
  ('OR with NOT',         'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 10, 20, 1) OR NOT pos <@ circle(''ICRS'', 10, 20, 170)'),
  ('two positions',       'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 8, 18, 1) OR point(''ICRS'', ra, dec) <@ circle(''ICRS'', 12, 22, 1.5)'),
  ('OR another term',     'SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 8, 18, 1) OR pos <@ circle(''ICRS'', 12, 22, 1.5) OR id = 7')
) v(name, q) ORDER BY name;
       name        |     kind      | agree 
-------------------+---------------+-------
 ADQL = 0          | custom scan   | t
 AND NOT           | custom scan   | t
 AND of two        | custom scan   | t
 OR another term   | other         | t
 OR of three, ADQL | custom scan   | t
 OR of two         | custom scan   | t
 OR with NOT       | custom scan   | t
 nested            | custom scan   | t
 two positions     | range rewrite | t
(9 rows)

SET skycell.fold_regions = off;
SELECT comp_plan_kind('SELECT count(*) FROM ccat WHERE pos <@ circle(''ICRS'', 8, 18, 1) OR pos <@ circle(''ICRS'', 12, 22, 1.5)') AS fold_off;
   fold_off    
---------------
 range rewrite
(1 row)

RESET skycell.fold_regions;
-- the folded region, as the plan shows it
EXPLAIN (COSTS OFF) SELECT count(*) FROM ccat
WHERE pos <@ circle('ICRS', 10, 20, 2) AND NOT pos <@ circle('ICRS', 10, 20, 1) AND NOT pos <@ circle('ICRS', 11, 20, 0.3);
                                                                            QUERY PLAN                                                                             
-------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Custom Scan (SkycellCone) on ccat
         Filter: skycell_region_scan('0'::bigint, coord1(pos), coord2(pos), 'DIFFERENCE ICRS (CIRCLE 10 20 2 UNION (CIRCLE 10 20 1 CIRCLE 11 20 0.3))'::skyregion)
         Index: ccat_pos
         Ranges: 13
         Mode: bitmap
(6 rows)

-- random booleans of circles and boxes, two or three deep, against the same
-- tests joined as written
CREATE FUNCTION rand_leaf_sql(p text) RETURNS text LANGUAGE sql VOLATILE AS $$
  SELECT CASE WHEN random() < 0.6
    THEN format('%s <@ circle(''ICRS'', %s, %s, %s)', p, round((6 + 8 * random())::numeric, 3), round((16 + 8 * random())::numeric, 3), round((0.2 + 2 * random())::numeric, 3))
    ELSE format('%s <@ box(''ICRS'', %s, %s, %s, %s)', p, round((6 + 8 * random())::numeric, 3), round((16 + 8 * random())::numeric, 3), round((0.5 + 3 * random())::numeric, 3), round((0.5 + 3 * random())::numeric, 3)) END $$;
CREATE FUNCTION rand_bool_sql(p text, depth int) RETURNS text LANGUAGE plpgsql VOLATILE AS $$
DECLARE k float8 := random();
BEGIN
  IF depth = 0 OR k < 0.2 THEN RETURN rand_leaf_sql(p); END IF;
  IF k < 0.5 THEN RETURN '(' || rand_bool_sql(p, depth - 1) || ' OR ' || rand_bool_sql(p, depth - 1) || ')'; END IF;
  IF k < 0.8 THEN RETURN '(' || rand_bool_sql(p, depth - 1) || ' AND ' || rand_bool_sql(p, depth - 1) || ')'; END IF;
  RETURN '(NOT ' || rand_bool_sql(p, depth - 1) || ')';
END $$;
SELECT count(*) AS booleans, count(*) FILTER (WHERE (comp_plan_rows(q)).agree) AS agree
FROM (SELECT format('SELECT count(*) FROM ccat WHERE %s', rand_bool_sql(CASE WHEN i % 2 = 0 THEN 'pos' ELSE 'point(''ICRS'', ra, dec)' END, 2 + i % 2)) q
      FROM generate_series(1, 60) i) t;
 booleans | agree 
----------+-------
       60 |    60
(1 row)

DROP FUNCTION rand_bool_sql(text, int), rand_leaf_sql(text);
DROP FUNCTION comp_plan_rows(text), comp_plan_kind(text);
DROP INDEX ccat_radec;
-- coverings keep every row, for many random composites
CREATE FUNCTION rand_leaf() RETURNS skyregion LANGUAGE sql VOLATILE AS $$
  SELECT CASE WHEN random() < 0.6 THEN circle('ICRS', 6 + 8 * random(), 16 + 8 * random(), 0.2 + 2 * random())
              ELSE box('ICRS', 6 + 8 * random(), 16 + 8 * random(), 0.5 + 3 * random(), 0.5 + 3 * random()) END $$;
CREATE FUNCTION rand_region(depth int) RETURNS skyregion LANGUAGE plpgsql VOLATILE AS $$
DECLARE k float8 := random();
BEGIN
  IF depth = 0 OR k < 0.25 THEN RETURN rand_leaf(); END IF;
  IF k < 0.45 THEN RETURN skycell_union(rand_region(depth - 1), rand_region(depth - 1)); END IF;
  IF k < 0.65 THEN RETURN skycell_intersection(rand_region(depth - 1), rand_region(depth - 1)); END IF;
  IF k < 0.85 THEN RETURN skycell_difference(rand_region(depth - 1), rand_region(depth - 1)); END IF;
  RETURN skycell_not(rand_region(depth - 1));
END $$;
CREATE TABLE crand AS SELECT i AS n, rand_region(3) AS r FROM generate_series(1, 40) i;
SELECT count(*) AS composites, count(*) FILTER (WHERE c.idx = c.seq AND c.idx = c.exact) AS agree,
       count(*) FILTER (WHERE split_part(c.seq, ':', 1)::int > 0) > 20 AS mostly_nonempty
FROM crand, comp_counts(r) c;
 composites | agree | mostly_nonempty 
------------+-------+-----------------
         40 |    40 | t
(1 row)

-- stored composites under each region index ------------------------------
CREATE TABLE cstore AS
SELECT n AS fid, r FROM crand
UNION ALL SELECT 100 + n, rand_leaf() FROM generate_series(1, 40) n
UNION ALL SELECT 200 + row_number() OVER (), r FROM cregs WHERE name <> 'empty';
CREATE TABLE cprobe AS
SELECT i AS pid, point('ICRS', 6 + 8 * random(), 16 + 8 * random()) AS p FROM generate_series(1, 300) i
UNION ALL SELECT 1000 + i, point('ICRS', 360 * random(), degrees(asin(2 * random() - 1))) FROM generate_series(1, 100) i;
ANALYZE cprobe;
-- regions to compare the stored ones with: cones, polygons and composites
CREATE TABLE cquery AS
SELECT i AS qid, CASE i % 3 WHEN 0 THEN rand_leaf() ELSE rand_region(2) END AS q FROM generate_series(1, 20) i;
CREATE FUNCTION store_counts(OUT name text, OUT idx text, OUT seq text) RETURNS SETOF record
LANGUAGE plpgsql AS $$
DECLARE q text;
BEGIN
  FOR name, q IN VALUES
    ('point join', 'SELECT count(*) || '':'' || coalesce(sum(fid * 10000 + pid), 0) FROM cprobe JOIN cstore ON r @> p'),
    ('one point',  'SELECT count(*) || '':'' || coalesce(sum(fid), 0) FROM cstore WHERE r @> point(''ICRS'', 10, 20)'),
    ('ADQL',       'SELECT count(*) || '':'' || coalesce(sum(fid), 0) FROM cstore WHERE contains(point(''ICRS'', 10.5, 19.5), r) = 1'),
    ('correlated', 'SELECT sum((SELECT count(*) FROM cstore WHERE r @> pr.p)) || '''' FROM cprobe pr'),
    ('overlap',    'SELECT count(*) || '':'' || coalesce(sum(fid * 100 + qid), 0) FROM cquery JOIN cstore ON r && q'),
    ('holds',      'SELECT count(*) || '':'' || coalesce(sum(fid * 100 + qid), 0) FROM cquery JOIN cstore ON r @> q'),
    ('inside',     'SELECT count(*) || '':'' || coalesce(sum(fid * 100 + qid), 0) FROM cquery JOIN cstore ON r <@ q'),
    ('ADQL meets', 'SELECT count(*) || '':'' || coalesce(sum(fid), 0) FROM cstore WHERE 1 = intersects(r, region(''DIFFERENCE ICRS (CIRCLE 10 20 3 CIRCLE 10 20 1)''))'),
    ('ADQL in',    'SELECT count(*) || '':'' || coalesce(sum(fid), 0) FROM cstore WHERE 1 = contains(r, circle(''ICRS'', 10, 20, 3))')
  LOOP
    SET LOCAL enable_seqscan = off;
    SET LOCAL enable_indexscan = on;
    SET LOCAL enable_bitmapscan = on;
    SET LOCAL enable_hashjoin = off;
    SET LOCAL enable_mergejoin = off;
    EXECUTE q INTO idx;
    SET LOCAL enable_seqscan = on;
    SET LOCAL enable_indexscan = off;
    SET LOCAL enable_bitmapscan = off;
    EXECUTE q INTO seq;
    RETURN NEXT;
  END LOOP;
END $$;
CREATE INDEX cstore_r ON cstore USING gist (r);
ANALYZE cstore;
SELECT 'gist' AS idx, name, idx = seq AS agree, split_part(seq, ':', 1)::bigint > 0 AS nonempty
FROM store_counts() ORDER BY name;
 idx  |    name    | agree | nonempty 
------+------------+-------+----------
 gist | ADQL       | t     | t
 gist | ADQL in    | t     | t
 gist | ADQL meets | t     | t
 gist | correlated | t     | t
 gist | holds      | t     | t
 gist | inside     | t     | t
 gist | one point  | t     | t
 gist | overlap    | t     | t
 gist | point join | t     | t
(9 rows)

DROP INDEX cstore_r;
CREATE INDEX cstore_box4 ON cstore USING gist (r skyregion_box4_gist_ops);
SELECT 'box4' AS idx, name, idx = seq AS agree FROM store_counts() ORDER BY name;
 idx  |    name    | agree 
------+------------+-------
 box4 | ADQL       | t
 box4 | ADQL in    | t
 box4 | ADQL meets | t
 box4 | correlated | t
 box4 | holds      | t
 box4 | inside     | t
 box4 | one point  | t
 box4 | overlap    | t
 box4 | point join | t
(9 rows)

DROP INDEX cstore_box4;
CREATE INDEX cstore_moc ON cstore USING gin (skycell_region_moc(r));
ANALYZE cstore;
SELECT 'moc' AS idx, name, idx = seq AS agree FROM store_counts() ORDER BY name;
 idx |    name    | agree 
-----+------------+-------
 moc | ADQL       | t
 moc | ADQL in    | t
 moc | ADQL meets | t
