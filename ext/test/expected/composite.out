-- membership: each composite against its pieces --------------------------
CREATE TABLE cpts AS
SELECT i AS id, point('ICRS', 8 + 4 * random(), 18 + 4 * random()) AS p FROM generate_series(1, 5000) i;
CREATE TABLE cparts AS SELECT circle('ICRS', 10, 20, 1) AS a, circle('ICRS', 10.6, 20, 0.8) AS b,
                              polygon('ICRS', 9, 19, 11, 19, 10, 21.5) AS c;
SELECT bool_and(contains(p, skycell_union(a, b, c)) = (contains(p, a) | contains(p, b) | contains(p, c))) AS u_ok,
       bool_and(contains(p, skycell_intersection(a, b, c)) = (contains(p, a) & contains(p, b) & contains(p, c))) AS i_ok,
       bool_and(contains(p, skycell_difference(a, b)) = (contains(p, a) & (1 - contains(p, b)))) AS d_ok,
       bool_and(contains(p, skycell_not(c)) = 1 - contains(p, c)) AS n_ok,
       bool_and((p <@ skycell_difference(skycell_union(a, c), skycell_not(b)))
                = ((p <@ a OR p <@ c) AND p <@ b)) AS nested_ok,
       count(*) FILTER (WHERE p <@ skycell_difference(a, b)) > 0 AS d_nonempty,
       count(*) FILTER (WHERE p <@ skycell_intersection(a, b, c)) > 0 AS i_nonempty
FROM cpts, cparts;
 u_ok | i_ok | d_ok | n_ok | nested_ok | d_nonempty | i_nonempty 
------+------+------+------+-----------+------------+------------
 t    | t    | t    | t    | t         | t          | t
(1 row)

-- an annulus: in the ring, not in the hole, not outside
SELECT contains(point('ICRS', 10, 20.75), r) AS ring, contains(point('ICRS', 10, 20), r) AS hole,
       contains(point('ICRS', 10, 21.5), r) AS outside
FROM (SELECT region('DIFFERENCE ICRS (CIRCLE 10 20 1 CIRCLE 10 20 0.5)') AS r) t;
 ring | hole | outside 
------+------+---------
    1 |    0 |       0
(1 row)

-- region against region: from the operands where the operator decides it,
-- by refining cells otherwise; each answer here can be checked by hand
SELECT r && circle('ICRS', 50, 10, 0.3) AS hole_meets_annulus,       -- f: inside the hole
       r && circle('ICRS', 50, 10, 0.6) AS reaches_ring,             -- t
       circle('ICRS', 50, 10, 0.3) <@ skycell_not(r) AS hole_outside, -- t
       circle('ICRS', 50, 11.2, 0.2) <@ r AS in_ring,                -- t
       circle('ICRS', 50, 10.8, 0.4) <@ r AS over_hole_edge,         -- f: reaches the hole
       r <@ circle('ICRS', 50, 10, 2.01) AS inside_bigger,          -- t
       r <@ circle('ICRS', 50.1, 10, 2) AS not_inside_shifted       -- f
FROM (SELECT region('DIFFERENCE ICRS (CIRCLE 50 10 2 CIRCLE 50 10 0.5)') AS r) t;
 hole_meets_annulus | reaches_ring | hole_outside | in_ring | over_hole_edge | inside_bigger | not_inside_shifted 
--------------------+--------------+--------------+---------+----------------+---------------+--------------------
 f                  | t            | t            | t       | f              | t             | f
(1 row)

SELECT r && circle('ICRS', 90.4, 0, 0.05) AS in_lens,                -- t
       r && circle('ICRS', 89.2, 0, 0.1) AS one_circle_only,         -- f
       circle('ICRS', 71, 0, 0.3) <@ u AS across_the_gap,            -- f: 71.0-71.5 is in neither piece
       circle('ICRS', 70.6, 0, 0.3) <@ u AS in_the_circle,           -- t
       circle('ICRS', 70.9, 0, 0.15) <@ skycell_union(u, circle('ICRS', 71.25, 0, 0.3)) AS needs_both, -- t
       1 = intersects(skycell_not(circle('ICRS', 0, 0, 10)), circle('ICRS', 0, 0, 5)) AS not_meets_inner,  -- f
       1 = contains(circle('ICRS', 40, 0, 5), skycell_not(circle('ICRS', 0, 0, 10))) AS outer_in_not,    -- t
       skycell_not(circle('ICRS', 0, 0, 10)) <@ skycell_not(circle('ICRS', 0, 0, 5)) AS nots_nest,       -- t
       r <@ r AND u <@ u AS self                                     -- t
FROM (SELECT skycell_intersection(circle('ICRS', 90, 0, 1), circle('ICRS', 90.8, 0, 1)) AS r,
             region('UNION ICRS (CIRCLE 70 0 1 POLYGON 71 -1 73 -1 72 1)') AS u) t;
 in_lens | one_circle_only | across_the_gap | in_the_circle | needs_both | not_meets_inner | outer_in_not | nots_nest | self 
---------+-----------------+----------------+---------------+------------+-----------------+--------------+-----------+------
 t       | f               | f              | t             | t          | f               | t            | t         | t
(1 row)

-- AREA and CENTROID: integrated over cells, against what is known exactly.
-- An annulus is its circles' difference; a union and an intersection add up
-- to their pieces; a lens of equal circles is centred on the great-circle
-- midpoint of their centres; a NOT is exact, and points the other way
SELECT abs(area(r) - (area(circle('ICRS', 10, 20, 1)) - area(circle('ICRS', 10, 20, 0.5)))) / area(r) < 1e-3 AS annulus_area,
       distance(centroid(r), point('ICRS', 10, 20)) < 1e-3 AS annulus_centre
FROM (SELECT region('DIFFERENCE ICRS (CIRCLE 10 20 1 CIRCLE 10 20 0.5)') AS r) t;
 annulus_area | annulus_centre 
--------------+----------------
 t            | t
(1 row)

SELECT abs(area(skycell_union(a, b)) + area(skycell_intersection(a, b)) - area(a) - area(b))
         / (area(a) + area(b)) < 1e-3 AS inclusion_exclusion,
       abs(area(skycell_union(p, a)) + area(skycell_intersection(p, a)) - area(p) - area(a))
         / (area(p) + area(a)) < 1e-3 AS with_a_polygon,
       distance(centroid(skycell_intersection(a, b)), point('ICRS', 10.5, 20.00068)) < 1e-3 AS lens_centre,
       distance(centroid(region('DIFFERENCE ICRS (CIRCLE 10 20 1 CIRCLE 10.3 20 0.5)')), point('ICRS', 10, 20)) > 0.05 AS hole_pulls_away,
       round(area(skycell_not(a))::numeric, 6) = round((41252.961249419271 - area(a))::numeric, 6) AS not_area,
       distance(centroid(skycell_not(a)), point('ICRS', 190, -20)) < 1e-9 AS not_centre,
       abs(area(skycell_not(skycell_union(a, b))) - (41252.961249419271 - area(skycell_union(a, b)))) < 1e-2 AS not_union
FROM (SELECT circle('ICRS', 10, 20, 1) AS a, circle('ICRS', 11, 20, 1) AS b,
             polygon('ICRS', 10,19, 12,19, 12,21, 10,21) AS p) t;
 inclusion_exclusion | with_a_polygon | lens_centre | hole_pulls_away | not_area | not_centre | not_union 
---------------------+----------------+-------------+-----------------+----------+------------+-----------
 t                   | t              | t           | t               | t        | t          | t
(1 row)

