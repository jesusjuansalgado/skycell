SELECT skycell_moc_agg(13, ipix) FROM generate_series(0, 3) ipix;
ERROR:  skycell: MOC order must be within [0, 12]
SELECT skycell_moc_agg(2, ipix) FROM (VALUES (192)) v(ipix);
ERROR:  skycell: no HEALPix cell 192 at order 2
